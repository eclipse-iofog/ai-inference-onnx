# QNN engine image.
# The runtime library and the HTP backend libraries come from the onnxruntime build context.
# The board supplies the FastRPC loader. The image does not install a driver.

FROM scratch AS onnxruntime

FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:217dd5692d369799d34d09ffb6f5f3404efebc7900834490fdf9ae92fd6721d4 AS engine-ubi

ARG TARGETARCH
RUN if [ "$TARGETARCH" != arm64 ]; then echo "QNN is built for arm64" >&2; exit 1; fi
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        gcc-toolset-14-gcc-c++ \
        gcc-toolset-14-binutils \
        ca-certificates \
        tar \
        gzip \
    && go_sum=3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797 \
    && curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go1.26.10.linux-arm64.tar.gz" \
    && echo "${go_sum}  /tmp/go.tgz" | sha256sum -c - \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm -f /tmp/go.tgz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

ENV PATH=/usr/local/go/bin:${PATH} \
    GOTOOLCHAIN=local

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG OCI_VERSION=dev
RUN set -eu; \
    . /opt/rh/gcc-toolset-14/enable; \
    mkdir -p /out; \
    CGO_ENABLED=1 go build -trimpath -buildvcs=false -ldflags "-X github.com/eclipse-iofog/ai-inference-onnx/internal/buildinfo.Version=${OCI_VERSION}" -o /out/inference ./cmd/inference; \
    if readelf -d /out/inference | grep -q 'libonnxruntime'; then \
      echo "engine binary links the runtime library" >&2; \
      exit 1; \
    fi

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:6f3a78179e0b30b930a186e7f68a4af52e51bb82406c9653be10bddd624e40f5 AS user-staging-ubi

# The first zone-data install leaves the zone names as empty links. Reinstall fills them in.
RUN microdnf install -y --setopt=install_weak_deps=0 \
        shadow-utils \
        ca-certificates \
        libstdc++ \
        libatomic \
        tzdata \
    && microdnf reinstall -y tzdata \
    && microdnf clean all \
    && test -e /usr/lib64/libstdc++.so.6 \
    && test -e /usr/lib64/libatomic.so.1 \
    && test -e /usr/share/zoneinfo/UTC \
    && test -x /usr/bin/curl \
    && test -x /usr/bin/grep \
    && test -f /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && groupadd --gid 10001 inference \
    && useradd --uid 10001 --gid 10001 --home-dir /home/inference --no-create-home --shell /sbin/nologin inference

FROM user-staging-ubi AS runtime-staging-ubi

RUN microdnf install -y --setopt=install_weak_deps=0 binutils \
    && microdnf clean all

COPY --from=engine-ubi /out/inference /staging/usr/local/bin/inference
COPY --from=onnxruntime /lib/ /staging/opt/onnxruntime/lib/
COPY --from=onnxruntime /licenses/ /staging/licenses/

RUN bash <<'ENDSCRIPT'
set -euo pipefail
mkdir -p \
  /staging/etc/pki/ca-trust/extracted/pem \
  /staging/etc/pki/tls/certs \
  /staging/usr/lib64 \
  /staging/usr/bin \
  /staging/var/cache/inference \
  /staging/home/inference
cp -a /etc/passwd /etc/group /staging/etc/
cp -a /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /staging/etc/pki/ca-trust/extracted/pem/
ln -s /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /staging/etc/pki/tls/certs/ca-bundle.crt
cp -a /usr/lib64/libstdc++.so.6 /usr/lib64/libstdc++.so.6.* /staging/usr/lib64/
cp -a /usr/lib64/libatomic.so.1* /staging/usr/lib64/
chmod 0755 /staging/usr/local/bin/inference
for lib in /staging/usr/lib64/* /staging/opt/onnxruntime/lib/*; do
  if [ -f "$lib" ] && [ ! -L "$lib" ]; then
    chmod 0755 "$lib"
  fi
done
chown root:root /staging/usr/local/bin/inference
chown -R root:root /staging/opt/onnxruntime/lib /staging/usr/lib64 /staging/licenses
chown -R 10001:10001 /staging/var/cache/inference /staging/home/inference
chmod 0750 /staging/var/cache/inference /staging/home/inference
test -e /staging/opt/onnxruntime/lib/libQnnHtp.so
host_object() {
  header=$(readelf -h "$1" 2>/dev/null || true)
  case "$header" in
    *AArch64*) return 0 ;;
  esac
  return 1
}
check_ldd() {
  local bin="$1" out line lib path base
  out="$(ldd "$bin" 2>&1)" || { printf '%s\n' "$out" >&2; echo "$bin: ldd failed" >&2; return 1; }
  while IFS= read -r line; do
    case "$line" in
      *'=> not found'*)
        set -- $line
        lib=$1
        case "$lib" in
          libcdsprpc.so*|libsdsprpc.so*) ;;
          *)
            printf '%s\n' "$out" >&2
            echo "$bin: missing library $lib" >&2
            return 1
            ;;
        esac
        ;;
      *'=> /'*)
        set -- $line
        path=$3
        base=${path##*/}
        case "$path" in
          /staging/*) ;;
          *)
            case "$base" in
              libc.so.6|libm.so.6|libdl.so.2|libpthread.so.0|librt.so.1|libresolv.so.2|libgcc_s.so.1|ld-linux-*.so.*) ;;
              *)
                echo "$bin: $base is outside the staged root ($path)" >&2
                return 1
                ;;
            esac
            ;;
        esac
        ;;
    esac
  done <<EOF
$out
EOF
}
check_abi() {
  local bin="$1" syms sym ver ceiling first
  if readelf -d "$bin" | grep -E 'RPATH|RUNPATH' | grep -q '/opt/rh/'; then
    echo "$bin: runtime path points at the compiler toolset" >&2
    return 1
  fi
  syms="$(objdump -T "$bin" | grep '\*UND\*' | grep -oE 'GLIBC_[0-9]+\.[0-9]+|GLIBCXX_[0-9]+\.[0-9]+\.[0-9]+' | sort -u || true)"
  for sym in $syms; do
    case "$sym" in
      GLIBC_*) ver="${sym#GLIBC_}"; ceiling=2.34 ;;
      GLIBCXX_*) ver="${sym#GLIBCXX_}"; ceiling=3.4.29 ;;
      *) continue ;;
    esac
    first="$(printf '%s\n%s\n' "$ceiling" "$ver" | sort -V | head -n 1)"
    if [ "$first" = "$ceiling" ] && [ "$ver" != "$ceiling" ]; then
      echo "$bin: needs a symbol newer than glibc 2.34 or GLIBCXX_3.4.29: $sym" >&2
      return 1
    fi
  done
}
fail=0
export LD_LIBRARY_PATH=/staging/usr/lib64:/staging/opt/onnxruntime/lib
check_ldd /staging/usr/local/bin/inference || fail=1
check_abi /staging/usr/local/bin/inference || fail=1
if readelf -d /staging/usr/local/bin/inference | grep -q 'libonnxruntime'; then
  echo "engine binary links the runtime library" >&2
  fail=1
fi
for lib in /staging/usr/lib64/* /staging/opt/onnxruntime/lib/*; do
  if [ -f "$lib" ] && [ ! -L "$lib" ] && host_object "$lib"; then
    check_ldd "$lib" || fail=1
    check_abi "$lib" || fail=1
  fi
done
test "$fail" -eq 0
ENDSCRIPT

# curl answers health checks. Zone data lets TZ select local time. The default is UTC.
RUN bash <<'ENDSCRIPT'
set -euo pipefail
mkdir -p /staging/usr/bin /staging/usr/lib64 /staging/usr/share
cp -a /usr/bin/curl /usr/bin/grep /staging/usr/bin/
cp -a /usr/share/zoneinfo /staging/usr/share/zoneinfo
copy_soname() {
  src="/usr/lib64/$1"
  hops=0
  while [ -e "$src" ]; do
    cp -a "$src" /staging/usr/lib64/
    if [ ! -L "$src" ]; then
      return 0
    fi
    hops=$((hops + 1))
    if [ "$hops" -gt 4 ]; then
      echo "$1: too many links" >&2
      return 1
    fi
    target=$(readlink "$src")
    case "$target" in
      /*) src=$target ;;
      *) src="/usr/lib64/$target" ;;
    esac
  done
  echo "missing $1" >&2
  return 1
}
names=(
  libcurl.so.4
  libnghttp2.so.14
  libssl.so.3
  libcrypto.so.3
  libz.so.1
  libgssapi_krb5.so.2
  libkrb5.so.3
  libk5crypto.so.3
  libcom_err.so.2
  libkrb5support.so.0
  libkeyutils.so.1
  libselinux.so.1
  libpcre2-8.so.0
  libpcre.so.1
  libsigsegv.so.2
)
for name in "${names[@]}"; do
  copy_soname "$name"
  test -e "/staging/usr/lib64/$name"
done
test -x /staging/usr/bin/curl
test -x /staging/usr/bin/grep
test -e /staging/usr/share/zoneinfo/UTC
chmod 0755 /staging/usr/bin/curl /staging/usr/bin/grep
for lib in /staging/usr/lib64/*; do
  if [ -f "$lib" ] && [ ! -L "$lib" ]; then
    chmod 0755 "$lib"
  fi
done
chown root:root /staging/usr/bin/curl /staging/usr/bin/grep
chown -R root:root /staging/usr/lib64 /staging/usr/share/zoneinfo
check_staged() {
  bin=$1
  out=$(LD_LIBRARY_PATH=/staging/usr/lib64 ldd "$bin" 2>&1) || {
    printf '%s\n' "$out" >&2
    echo "$bin: ldd failed" >&2
    return 1
  }
  case "$out" in
    *'not found'*)
      printf '%s\n' "$out" >&2
      echo "$bin: missing library" >&2
      return 1
      ;;
  esac
  while IFS= read -r line; do
    case "$line" in
      *'=> /'*)
        set -- $line
        path=$3
        base=${path##*/}
        case "$path" in
          /staging/*) ;;
          *)
            case "$base" in
              libc.so.6|libm.so.6|libdl.so.2|libpthread.so.0|librt.so.1|libresolv.so.2|libgcc_s.so.1|ld-linux-*.so.*) ;;
              *)
                echo "$bin: $base is outside the staged root ($path)" >&2
                exit 1
                ;;
            esac
            ;;
        esac
        ;;
    esac
  done <<EOF
$out
EOF
}
check_staged /staging/usr/bin/curl
check_staged /staging/usr/bin/grep
for name in "${names[@]}"; do
  for lib in /staging/usr/lib64/"$name"*; do
    if [ -f "$lib" ] && [ ! -L "$lib" ]; then
      check_staged "$lib"
    fi
  done
done
ENDSCRIPT

FROM registry.access.redhat.com/ubi9/ubi-micro:9.8@sha256:5be877a2a280ae36eb9ab80ca4efb28bbf77c57abbba38137cdc37a03b8465e6 AS final-ubi

COPY --from=runtime-staging-ubi /staging/ /

ARG OCI_SOURCE_REPO
ARG OCI_VERSION
ARG OCI_REVISION
ARG QNN_VERSION=2.51.0.260929

ENV ORT_LIB_PATH=/opt/onnxruntime/lib/libonnxruntime.so.1.31.0 \
    HOME=/home/inference \
    XDG_CACHE_HOME=/var/cache \
    ADSP_LIBRARY_PATH=/opt/onnxruntime/lib \
    TZ=UTC

LABEL org.opencontainers.image.version="${OCI_VERSION}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.source="${OCI_SOURCE_REPO}" \
      org.opencontainers.image.licenses="EPL-2.0" \
      org.eclipse.iofog.inference.onnxruntime="1.31.0" \
      org.eclipse.iofog.inference.qnn="${QNN_VERSION}"

USER 10001:10001
WORKDIR /home/inference
EXPOSE 8000 8001 8002
ENTRYPOINT ["/usr/local/bin/inference"]
