# OpenVINO ONNX Runtime 1.31.0.
# amd64 compiles on UBI 9 with GCC 14.
# OpenVINO 2026.2.1 is the RHEL 8 archive, which stays within this image's glibc and libstdc++.
# The device is CPU. The engine image stages the OpenVINO libraries.

FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:48393e4261b2544f652c915b3e052256ddf66ee95cd04dc0362191f302c4e94a AS build-ubi

ARG TARGETARCH
ARG OPENVINO_VERSION=2026.2.1
ARG OPENVINO_URL=https://storage.openvinotoolkit.org/repositories/openvino/packages/2026.2.1/linux/openvino_toolkit_rhel8_2026.2.1.21919.ede283a88e3_x86_64.tgz
ARG OPENVINO_SHA256=cf7a3eb84a1edbd852f719a4ba8c15dbf02a3744ab61488b6cae44747d90bf78

RUN if [ "$TARGETARCH" != amd64 ]; then echo "OpenVINO is built for amd64" >&2; exit 1; fi
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        gcc-toolset-14-gcc-c++ \
        gcc-toolset-14-binutils \
        binutils \
        python3 \
        python3.12 \
        git \
        make \
        ca-certificates \
        tar \
        gzip \
        findutils \
        patch \
        zlib-devel \
    && cmake_sum=312d78e0b7c5c9b4a97a87a46c3e525aa84895fe8135c238c4616bba73dc9518 \
    && curl -fsSL -o /tmp/cmake.tgz \
         "https://github.com/Kitware/CMake/releases/download/v3.31.9/cmake-3.31.9-linux-x86_64.tar.gz" \
    && echo "${cmake_sum}  /tmp/cmake.tgz" | sha256sum -c - \
    && tar -C /usr/local --strip-components=1 -xzf /tmp/cmake.tgz \
    && rm -f /tmp/cmake.tgz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY scripts/build-onnxruntime.sh /usr/local/bin/build-onnxruntime.sh

RUN OPENVINO_VERSION="$OPENVINO_VERSION" OPENVINO_URL="$OPENVINO_URL" OPENVINO_SHA256="$OPENVINO_SHA256" bash <<'ENDSCRIPT'
set -euo pipefail
curl -fsSL -o /tmp/openvino.tgz "$OPENVINO_URL"
echo "${OPENVINO_SHA256}  /tmp/openvino.tgz" | sha256sum -c -
mkdir -p /tmp/openvino-src
tar -C /tmp/openvino-src -xzf /tmp/openvino.tgz
rm -f /tmp/openvino.tgz
src=$(find /tmp/openvino-src -mindepth 1 -maxdepth 1 -type d -print -quit)
test -n "$src"
test -f "$src/runtime/cmake/OpenVINOConfig.cmake"
test -f "$src/runtime/version.txt"
grep -q "^${OPENVINO_VERSION}" "$src/runtime/version.txt"
root="/opt/intel/openvino_${OPENVINO_VERSION}"
mkdir -p /opt/intel
rm -rf "$root"
mv "$src" "$root"
rm -rf /tmp/openvino-src
test -f "$root/runtime/lib/intel64/libopenvino.so"
ENDSCRIPT

FROM build-ubi AS build-amd64
RUN build-onnxruntime.sh openvino amd64

FROM build-${TARGETARCH} AS build

FROM scratch AS runtime
COPY --from=build /opt/onnxruntime/lib/ /lib/
COPY --from=build /opt/onnxruntime/include/ /include/
COPY --from=build /opt/onnxruntime/licenses/ /licenses/
COPY --from=build /opt/onnxruntime/VERSION /VERSION
COPY --from=build /opt/onnxruntime/COMMIT /COMMIT
