# CPU ONNX Runtime 1.31.0.
# amd64 and arm64 compile on UBI 9 with GCC 14.
# riscv64 cross-compiles on linux/amd64 with a pinned riscv64-unknown-linux-gnu toolchain.
# The last stage is a scratch image with the library, headers, licenses, version, and commit.

FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:48393e4261b2544f652c915b3e052256ddf66ee95cd04dc0362191f302c4e94a AS build-ubi

ARG TARGETARCH
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        gcc-toolset-14-gcc-c++ \
        gcc-toolset-14-binutils \
        binutils \
        python3 \
        python3.12 \
        git \
        make \
        ca-certificates \
        tar \
        gzip \
        patch \
        zlib-devel \
    && case "$TARGETARCH" in \
         amd64) cmake_arch=x86_64; cmake_sum=312d78e0b7c5c9b4a97a87a46c3e525aa84895fe8135c238c4616bba73dc9518 ;; \
         arm64) cmake_arch=aarch64; cmake_sum=09b7127b09e3d3ed5fa894f4e59f6a01112f267da6acc4249e46dba97b14afcb ;; \
         *) echo "no CMake archive for ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/cmake.tgz \
         "https://github.com/Kitware/CMake/releases/download/v3.31.9/cmake-3.31.9-linux-${cmake_arch}.tar.gz" \
    && echo "${cmake_sum}  /tmp/cmake.tgz" | sha256sum -c - \
    && tar -C /usr/local --strip-components=1 -xzf /tmp/cmake.tgz \
    && rm -f /tmp/cmake.tgz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY scripts/build-onnxruntime.sh /usr/local/bin/build-onnxruntime.sh

FROM build-ubi AS build-amd64
RUN build-onnxruntime.sh cpu amd64

FROM build-ubi AS build-arm64
RUN build-onnxruntime.sh cpu arm64

FROM --platform=linux/amd64 debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS build-cross

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
         ca-certificates \
         curl \
         python3 \
         git \
         make \
         build-essential \
         binutils \
         patch \
    && cmake_sum=312d78e0b7c5c9b4a97a87a46c3e525aa84895fe8135c238c4616bba73dc9518 \
    && curl -fsSL -o /tmp/cmake.tgz \
         "https://github.com/Kitware/CMake/releases/download/v3.31.9/cmake-3.31.9-linux-x86_64.tar.gz" \
    && echo "${cmake_sum}  /tmp/cmake.tgz" | sha256sum -c - \
    && tar -C /usr/local --strip-components=1 -xzf /tmp/cmake.tgz \
    && rm -f /tmp/cmake.tgz \
    && curl -fsSL -o /tmp/riscv-toolchain.tgz \
         "https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/2024.04.12/riscv64-glibc-ubuntu-22.04-gcc-nightly-2024.04.12-nightly.tar.gz" \
    && echo "5a386a6170934d03f468f9818a8541a3c479d26c7fde82f685008b7f5e3f8ccc  /tmp/riscv-toolchain.tgz" | sha256sum -c - \
    && mkdir -p /opt/riscv \
    && tar -C /opt/riscv --strip-components=1 -xzf /tmp/riscv-toolchain.tgz \
    && rm -f /tmp/riscv-toolchain.tgz /opt/riscv/bin/qemu-riscv64 /opt/riscv/bin/qemu-riscv32 \
    && test -x /opt/riscv/bin/riscv64-unknown-linux-gnu-gcc \
    && test -d /opt/riscv/sysroot \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/build-onnxruntime.sh /usr/local/bin/build-onnxruntime.sh

FROM --platform=linux/amd64 build-cross AS build-riscv64
RUN build-onnxruntime.sh cpu riscv64

FROM build-${TARGETARCH} AS build

FROM scratch AS runtime
COPY --from=build /opt/onnxruntime/lib/ /lib/
COPY --from=build /opt/onnxruntime/include/ /include/
COPY --from=build /opt/onnxruntime/licenses/ /licenses/
COPY --from=build /opt/onnxruntime/VERSION /VERSION
COPY --from=build /opt/onnxruntime/COMMIT /COMMIT
