# QNN ONNX Runtime 1.31.0.
# arm64 compiles on UBI 9 with GCC 14.
# The SDK is the pinned Qualcomm AI Runtime Community archive.
# The scratch image keeps this runtime, its provider, and the HTP backend libraries.

FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:16e9e43d99e181463513cc84a514859b1abb9460f1c4d9e208da4b4e51cd5cc3 AS build-ubi

ARG TARGETARCH
ARG QNN_VERSION=2.51.0.260929

RUN if [ "$TARGETARCH" != arm64 ]; then echo "QNN is built for arm64" >&2; exit 1; fi
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        gcc-toolset-14-gcc-c++ \
        gcc-toolset-14-binutils \
        binutils \
        python3 \
        python3.12 \
        git \
        make \
        ca-certificates \
        tar \
        gzip \
        unzip \
        findutils \
        patch \
        zlib-devel \
    && cmake_sum=09b7127b09e3d3ed5fa894f4e59f6a01112f267da6acc4249e46dba97b14afcb \
    && curl -fsSL -o /tmp/cmake.tgz \
         "https://github.com/Kitware/CMake/releases/download/v3.31.9/cmake-3.31.9-linux-aarch64.tar.gz" \
    && echo "${cmake_sum}  /tmp/cmake.tgz" | sha256sum -c - \
    && tar -C /usr/local --strip-components=1 -xzf /tmp/cmake.tgz \
    && rm -f /tmp/cmake.tgz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY scripts/build-onnxruntime.sh /usr/local/bin/build-onnxruntime.sh

ENV QNN_VERSION=${QNN_VERSION}

RUN bash <<'ENDSCRIPT'
set -euo pipefail
url="https://softwarecenter.qualcomm.com/api/download/software/sdks/Qualcomm_AI_Runtime_Community/All/2.51.0.260929/v2.51.0.260929.zip"
sum=9b4ca798902f02a2543857f5de4d233830c044d19701b92fc66a12fdc292211f
if ! curl -fsSL -o /tmp/qnn-sdk "$url" 2>/tmp/curl.err; then
  echo "QNN SDK download failed" >&2
  rm -f /tmp/curl.err /tmp/qnn-sdk
  exit 1
fi
rm -f /tmp/curl.err
echo "${sum}  /tmp/qnn-sdk" | sha256sum -c -
mkdir -p /tmp/qnn-src
if unzip -tq /tmp/qnn-sdk >/dev/null 2>&1; then
  unzip -q /tmp/qnn-sdk -d /tmp/qnn-src
elif tar -tf /tmp/qnn-sdk >/dev/null 2>&1; then
  tar -C /tmp/qnn-src -xf /tmp/qnn-sdk
else
  echo "QNN SDK archive is not zip or tar" >&2
  exit 1
fi
rm -f /tmp/qnn-sdk
sdk=$(find /tmp/qnn-src -name sdk.yaml -type f -print -quit)
if [ -z "$sdk" ]; then
  echo "QNN SDK archive has no sdk.yaml" >&2
  exit 1
fi
home=$(dirname "$sdk")
test -d "$home/include"
test -d "$home/lib"
rm -rf "/opt/qnn-${QNN_VERSION}"
mkdir -p "/opt/qnn-${QNN_VERSION}"
cp -a "$home/." "/opt/qnn-${QNN_VERSION}/"
rm -rf /tmp/qnn-src
test -d "/opt/qnn-${QNN_VERSION}/include/QNN" || test -d "/opt/qnn-${QNN_VERSION}/include"
ENDSCRIPT

FROM build-ubi AS build-arm64
RUN build-onnxruntime.sh qnn arm64
RUN bash <<'ENDSCRIPT'
set -euo pipefail
version="${QNN_VERSION}"
root="/opt/qnn-${version}"
dest=/opt/onnxruntime/lib
abi=""
for candidate in \
  aarch64-oe-linux-gcc11.2 \
  aarch64-oe-linux-gcc9.4 \
  aarch64-ubuntu-gcc11.2 \
  aarch64-ubuntu-gcc9.4
do
  if [ -d "${root}/lib/${candidate}" ]; then
    abi="$candidate"
    break
  fi
done
if [ -z "$abi" ]; then
  echo "QNN SDK has no Linux aarch64 library directory" >&2
  exit 1
fi
shopt -s nullglob
if [ ! -f "${root}/lib/${abi}/libQnnHtp.so" ]; then
  echo "QNN HTP backend library was not staged" >&2
  exit 1
fi
if [ ! -f "${root}/lib/${abi}/libQnnSystem.so" ]; then
  echo "QNN system library was not staged" >&2
  exit 1
fi
cp -a "${root}/lib/${abi}/libQnnHtp.so" "$dest/"
cp -a "${root}/lib/${abi}/libQnnSystem.so" "$dest/"
stubs=("${root}/lib/${abi}/libQnnHtpV"*Stub.so)
if [ "${#stubs[@]}" -eq 0 ]; then
  echo "QNN HTP stub library was not staged" >&2
  exit 1
fi
cp -a "${stubs[@]}" "$dest/"
prepare=0
for name in libHtpPrepare.so libQnnHtpPrepare.so; do
  if [ -e "${root}/lib/${abi}/${name}" ]; then
    cp -a "${root}/lib/${abi}/${name}" "$dest/"
    prepare=1
  fi
done
if [ "$prepare" -ne 1 ]; then
  echo "QNN HTP prepare library was not staged" >&2
  exit 1
fi
skels=("${root}/lib"/hexagon-*/unsigned/libQnnHtpV*Skel.so)
if [ "${#skels[@]}" -eq 0 ]; then
  echo "QNN HTP skel library was not staged" >&2
  exit 1
fi
cp -a "${skels[@]}" "$dest/"
shopt -u nullglob
if [ -f "${root}/LICENSE.pdf" ]; then
  cp -a "${root}/LICENSE.pdf" /opt/onnxruntime/licenses/Qualcomm_LICENSE.pdf
fi
for f in "$dest"/*; do
  if [ -f "$f" ] && [ ! -L "$f" ]; then
    chmod 0755 "$f"
  fi
done
ENDSCRIPT

FROM build-${TARGETARCH} AS build

FROM scratch AS runtime
COPY --from=build /opt/onnxruntime/lib/ /lib/
COPY --from=build /opt/onnxruntime/include/ /include/
COPY --from=build /opt/onnxruntime/licenses/ /licenses/
COPY --from=build /opt/onnxruntime/VERSION /VERSION
COPY --from=build /opt/onnxruntime/COMMIT /COMMIT
