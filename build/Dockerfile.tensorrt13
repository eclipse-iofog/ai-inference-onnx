FROM cuda-libs-${TARGETARCH} AS cuda-libs

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661 AS tensorrt-amd64

ARG TARGETARCH
ARG TENSORRT_VERSION=10.14.1.48
ARG TENSORRT_URL=https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/10.14.1/tars/TensorRT-10.14.1.48.Linux.x86_64-gnu.cuda-13.0.tar.gz
ARG TENSORRT_SHA256=c74af67db57f1a0d7e66bb01ab93f1ecda5facac491ca76e680d832f1e035ce6

RUN microdnf install -y --setopt=install_weak_deps=0 ca-certificates curl tar gzip findutils bash \
    && microdnf clean all
RUN TENSORRT_VERSION="$TENSORRT_VERSION" TENSORRT_URL="$TENSORRT_URL" TENSORRT_SHA256="$TENSORRT_SHA256" bash <<'ENDSCRIPT'
set -euo pipefail
curl -fsSL -o /tmp/tensorrt.tar.gz "$TENSORRT_URL"
echo "${TENSORRT_SHA256}  /tmp/tensorrt.tar.gz" | sha256sum -c -
mkdir -p /tmp/tensorrt-src /out/lib /out/licenses
tar -C /tmp/tensorrt-src -xzf /tmp/tensorrt.tar.gz \
  --wildcards \
  '*/lib/*.so' \
  '*/lib/*.so.*' \
  '*/targets/*/lib/*.so' \
  '*/targets/*/lib/*.so.*' \
  '*/LICENSE' \
  '*/LICENSE.txt' \
  '*/License.txt' \
  '*/license*' \
  '*/doc/Acknowledgements.txt' \
  '*/doc/README.txt'
rm -f /tmp/tensorrt.tar.gz
src=$(find /tmp/tensorrt-src -mindepth 1 -maxdepth 1 -type d -print -quit)
copy_so() {
  dir=$1
  [ -d "$dir" ] || return 0
  for f in "$dir"/*; do
    base=$(basename "$f")
    case "$base" in
      *win*) continue ;;
      libnvinfer*.so*|libnvonnxparser*.so*|libnvdla*.so*) ;;
      *) continue ;;
    esac
    cp -a "$f" /out/lib/
  done
}
copy_so "$src/lib"
for d in "$src"/targets/*/lib; do
  copy_so "$d"
done
for f in /out/lib/*; do
  if [ -L "$f" ]; then
    resolved=$(readlink -f "$f")
    base=$(basename "$resolved")
    if [ ! -e "/out/lib/$base" ]; then
      cp -a "$resolved" "/out/lib/$base"
    fi
    ln -sfn "$base" "$f"
  fi
done
test -e /out/lib/libnvinfer.so.10
test -e /out/lib/libnvinfer_plugin.so.10
test -e /out/lib/libnvonnxparser.so.10
found=0
while IFS= read -r license; do
  [ -n "$license" ] || continue
  cp -a "$license" "/out/licenses/$(basename "$license")"
  found=1
done <<EOF
$(find "$src" -maxdepth 2 -type f \( -iname '*license*' -o -name 'Acknowledgements.txt' -o -name 'README.txt' \) -print)
EOF
if [ "$found" -ne 1 ]; then
  echo "TensorRT license is missing" >&2
  exit 1
fi
rm -rf /tmp/tensorrt-src
ENDSCRIPT


FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661 AS tensorrt-arm64

ARG TARGETARCH
ARG TENSORRT_VERSION=10.15.1.29
ARG TENSORRT_URL=https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/10.15.1/tars/TensorRT-10.15.1.29.Linux.aarch64-gnu.cuda-13.1.tar.gz
ARG TENSORRT_SHA256=df0c112a4d66bd8ef890697297e01558d7338d5c4ac85d4078e814e506bd6da2

RUN microdnf install -y --setopt=install_weak_deps=0 ca-certificates curl tar gzip findutils bash \
    && microdnf clean all
RUN TENSORRT_VERSION="$TENSORRT_VERSION" TENSORRT_URL="$TENSORRT_URL" TENSORRT_SHA256="$TENSORRT_SHA256" bash <<'ENDSCRIPT'
set -euo pipefail
curl -fsSL -o /tmp/tensorrt.tar.gz "$TENSORRT_URL"
echo "${TENSORRT_SHA256}  /tmp/tensorrt.tar.gz" | sha256sum -c -
mkdir -p /tmp/tensorrt-src /out/lib /out/licenses
tar -C /tmp/tensorrt-src -xzf /tmp/tensorrt.tar.gz \
  --wildcards \
  '*/lib/*.so' \
  '*/lib/*.so.*' \
  '*/targets/*/lib/*.so' \
  '*/targets/*/lib/*.so.*' \
  '*/LICENSE' \
  '*/LICENSE.txt' \
  '*/License.txt' \
  '*/license*' \
  '*/doc/Acknowledgements.txt' \
  '*/doc/README.txt'
rm -f /tmp/tensorrt.tar.gz
src=$(find /tmp/tensorrt-src -mindepth 1 -maxdepth 1 -type d -print -quit)
copy_so() {
  dir=$1
  [ -d "$dir" ] || return 0
  for f in "$dir"/*; do
    base=$(basename "$f")
    case "$base" in
      *win*) continue ;;
      libnvinfer*.so*|libnvonnxparser*.so*|libnvdla*.so*) ;;
      *) continue ;;
    esac
    cp -a "$f" /out/lib/
  done
}
copy_so "$src/lib"
for d in "$src"/targets/*/lib; do
  copy_so "$d"
done
for f in /out/lib/*; do
  if [ -L "$f" ]; then
    resolved=$(readlink -f "$f")
    base=$(basename "$resolved")
    if [ ! -e "/out/lib/$base" ]; then
      cp -a "$resolved" "/out/lib/$base"
    fi
    ln -sfn "$base" "$f"
  fi
done
test -e /out/lib/libnvinfer.so.10
test -e /out/lib/libnvinfer_plugin.so.10
test -e /out/lib/libnvonnxparser.so.10
found=0
while IFS= read -r license; do
  [ -n "$license" ] || continue
  cp -a "$license" "/out/licenses/$(basename "$license")"
  found=1
done <<EOF
$(find "$src" -maxdepth 2 -type f \( -iname '*license*' -o -name 'Acknowledgements.txt' -o -name 'README.txt' \) -print)
EOF
if [ "$found" -ne 1 ]; then
  echo "TensorRT license is missing" >&2
  exit 1
fi
rm -rf /tmp/tensorrt-src
ENDSCRIPT

FROM tensorrt-${TARGETARCH} AS tensorrt

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661 AS user-staging-ubi

RUN microdnf install -y --setopt=install_weak_deps=0 \
        shadow-utils \
        ca-certificates \
        libstdc++ \
        zlib \
    && microdnf clean all \
    && test -e /usr/lib64/libstdc++.so.6 \
    && test -e /usr/lib64/libz.so.1 \
    && test -f /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && groupadd --gid 10001 inference \
    && useradd --uid 10001 --gid 10001 --home-dir /home/inference --no-create-home --shell /sbin/nologin inference

FROM user-staging-ubi AS runtime-staging-ubi

RUN microdnf install -y --setopt=install_weak_deps=0 binutils \
    && microdnf clean all

COPY --from=engine /out/inference /staging/usr/local/bin/inference
COPY --from=onnxruntime /lib/ /staging/opt/onnxruntime/lib/
COPY --from=onnxruntime /licenses/ /staging/licenses/
COPY --from=cuda-libs /out/lib/ /staging/usr/lib64/
COPY --from=cuda-libs /out/licenses/ /staging/licenses/
COPY --from=tensorrt /out/lib/ /staging/usr/lib64/
COPY --from=tensorrt /out/licenses/ /staging/licenses/

RUN bash <<'ENDSCRIPT'
set -euo pipefail
mkdir -p \
  /staging/etc/pki/ca-trust/extracted/pem \
  /staging/etc/pki/tls/certs \
  /staging/usr/lib64 \
  /staging/usr/bin \
  /staging/var/cache/inference/cuda \
  /staging/home/inference
cp -a /etc/passwd /etc/group /staging/etc/
cp -a /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /staging/etc/pki/ca-trust/extracted/pem/
ln -s /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /staging/etc/pki/tls/certs/ca-bundle.crt
cp -a /usr/lib64/libstdc++.so.6 /usr/lib64/libstdc++.so.6.* /staging/usr/lib64/
cp -a /usr/lib64/libz.so.1 /usr/lib64/libz.so.1.* /staging/usr/lib64/
if [ -f /usr/share/licenses/zlib/LICENSE ]; then
  cp -a /usr/share/licenses/zlib/LICENSE /staging/licenses/zlib-LICENSE
fi
chmod 0755 /staging/usr/local/bin/inference
for lib in /staging/usr/lib64/* /staging/opt/onnxruntime/lib/*; do
  if [ -f "$lib" ] && [ ! -L "$lib" ]; then
    chmod 0755 "$lib"
  fi
done
chown root:root /staging/usr/local/bin/inference
chown -R root:root /staging/opt/onnxruntime/lib /staging/usr/lib64 /staging/licenses
chown -R 10001:10001 /staging/var/cache/inference /staging/home/inference
chmod 0750 /staging/var/cache/inference /staging/var/cache/inference/cuda /staging/home/inference
check_ldd() {
  local bin="$1" out line lib path base
  out="$(ldd "$bin" 2>&1)" || { printf '%s\n' "$out" >&2; echo "$bin: ldd failed" >&2; return 1; }
  while IFS= read -r line; do
    case "$line" in
      *'=> not found'*)
        set -- $line
        lib=$1
        case "$lib" in
          libcuda.so|libcuda.so.1|libnvidia-ml.so|libnvidia-ml.so.1) ;;
          *)
            printf '%s\n' "$out" >&2
            echo "$bin: missing library $lib" >&2
            return 1
            ;;
        esac
        ;;
      *'=> /'*)
        set -- $line
        path=$3
        base=${path##*/}
        case "$path" in
          /staging/*) ;;
          *)
            case "$base" in
              libc.so.6|libm.so.6|libdl.so.2|libpthread.so.0|librt.so.1|libgcc_s.so.1|ld-linux-*.so.*) ;;
              *)
                echo "$bin: $base is outside the staged root ($path)" >&2
                return 1
                ;;
            esac
            ;;
        esac
        ;;
    esac
  done <<EOF
$out
EOF
}
check_abi() {
  local bin="$1" syms sym ver ceiling first
  if readelf -d "$bin" | grep -E 'RPATH|RUNPATH' | grep -q '/opt/rh/'; then
    echo "$bin: runtime path points at the compiler toolset" >&2
    return 1
  fi
  syms="$(objdump -T "$bin" | grep '\*UND\*' | grep -oE 'GLIBC_[0-9]+\.[0-9]+|GLIBCXX_[0-9]+\.[0-9]+\.[0-9]+' | sort -u || true)"
  for sym in $syms; do
    case "$sym" in
      GLIBC_*) ver="${sym#GLIBC_}"; ceiling=2.34 ;;
      GLIBCXX_*) ver="${sym#GLIBCXX_}"; ceiling=3.4.29 ;;
      *) continue ;;
    esac
    first="$(printf '%s\n%s\n' "$ceiling" "$ver" | sort -V | head -n 1)"
    if [ "$first" = "$ceiling" ] && [ "$ver" != "$ceiling" ]; then
      echo "$bin: needs a symbol newer than glibc 2.34 or GLIBCXX_3.4.29: $sym" >&2
      return 1
    fi
  done
}
fail=0
export LD_LIBRARY_PATH=/staging/usr/lib64:/staging/opt/onnxruntime/lib
check_ldd /staging/usr/local/bin/inference || fail=1
check_abi /staging/usr/local/bin/inference || fail=1
if readelf -d /staging/usr/local/bin/inference | grep -q 'libonnxruntime'; then
  echo "engine binary links the runtime library" >&2
  fail=1
fi
for lib in /staging/usr/lib64/* /staging/opt/onnxruntime/lib/*; do
  if [ -f "$lib" ] && [ ! -L "$lib" ]; then
    check_ldd "$lib" || fail=1
    check_abi "$lib" || fail=1
  fi
done
test "$fail" -eq 0
ENDSCRIPT

FROM runtime-staging-ubi AS check-amd64
ARG TARGETARCH
RUN test "$TARGETARCH" = amd64

FROM runtime-staging-ubi AS check-arm64
ARG TARGETARCH
RUN test "$TARGETARCH" = arm64

FROM registry.access.redhat.com/ubi9/ubi-micro:9.8@sha256:5be877a2a280ae36eb9ab80ca4efb28bbf77c57abbba38137cdc37a03b8465e6 AS final-amd64

COPY --from=check-amd64 /staging/ /

ARG OCI_SOURCE_REPO
ARG OCI_VERSION
ARG OCI_REVISION
ARG CUDA_VERSION=13.0.2
ARG CUDNN_VERSION=9.14.0.64
ARG TENSORRT_VERSION=10.14.1.48

ENV ORT_LIB_PATH=/opt/onnxruntime/lib/libonnxruntime.so.1.31.0 \
    HOME=/home/inference \
    XDG_CACHE_HOME=/var/cache \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    CUDA_CACHE_PATH=/var/cache/inference/cuda

LABEL org.opencontainers.image.version="${OCI_VERSION}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.source="${OCI_SOURCE_REPO}" \
      org.opencontainers.image.licenses="EPL-2.0" \
      org.eclipse.iofog.inference.onnxruntime="1.31.0" \
      org.eclipse.iofog.inference.cuda="${CUDA_VERSION}" \
      org.eclipse.iofog.inference.cudnn="${CUDNN_VERSION}" \
      org.eclipse.iofog.inference.tensorrt="${TENSORRT_VERSION}"

USER 10001:10001
WORKDIR /home/inference
EXPOSE 8000 8001 8002
ENTRYPOINT ["/usr/local/bin/inference"]

FROM registry.access.redhat.com/ubi9/ubi-micro:9.8@sha256:5be877a2a280ae36eb9ab80ca4efb28bbf77c57abbba38137cdc37a03b8465e6 AS final-arm64

COPY --from=check-arm64 /staging/ /

ARG OCI_SOURCE_REPO
ARG OCI_VERSION
ARG OCI_REVISION
ARG CUDA_VERSION=13.1.2
ARG CUDNN_VERSION=9.17.1.4
ARG TENSORRT_VERSION=10.15.1.29

ENV ORT_LIB_PATH=/opt/onnxruntime/lib/libonnxruntime.so.1.31.0 \
    HOME=/home/inference \
    XDG_CACHE_HOME=/var/cache \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    CUDA_CACHE_PATH=/var/cache/inference/cuda

LABEL org.opencontainers.image.version="${OCI_VERSION}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.source="${OCI_SOURCE_REPO}" \
      org.opencontainers.image.licenses="EPL-2.0" \
      org.eclipse.iofog.inference.onnxruntime="1.31.0" \
      org.eclipse.iofog.inference.cuda="${CUDA_VERSION}" \
      org.eclipse.iofog.inference.cudnn="${CUDNN_VERSION}" \
      org.eclipse.iofog.inference.tensorrt="${TENSORRT_VERSION}"

USER 10001:10001
WORKDIR /home/inference
EXPOSE 8000 8001 8002
ENTRYPOINT ["/usr/local/bin/inference"]

# amd64 and arm64 publish different CUDA and TensorRT releases.
# This stage selects the final stage for the target architecture.
FROM final-${TARGETARCH} AS image
