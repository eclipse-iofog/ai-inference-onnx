# TensorRT 13 engine image.
# The runtime library comes from the onnxruntime build context.
# amd64 stages CUDA 13.0.2, cuDNN 9.14.0.64, and TensorRT 10.14.1.48.
# arm64 stages CUDA 13.1.2, cuDNN 9.17.1.4, and TensorRT 10.15.1.29.
# The image does not install a driver.

FROM scratch AS onnxruntime


FROM nvidia/cuda:13.0.2-cudnn-devel-ubi9@sha256:5a639207552c0322cf958b86149c7ab4d3d96b29eeb37ff523817c10b2afebc2 AS engine-amd64

ARG TARGETARCH
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        gcc-toolset-14-gcc-c++ \
        gcc-toolset-14-binutils \
        ca-certificates \
        curl \
        tar \
        gzip \
    && case "$TARGETARCH" in \
         amd64) go_sum=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5 ;; \
         arm64) go_sum=3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797 ;; \
         *) echo "no Go archive for ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go1.26.10.linux-${TARGETARCH}.tar.gz" \
    && echo "${go_sum}  /tmp/go.tgz" | sha256sum -c - \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm -f /tmp/go.tgz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

ENV PATH=/usr/local/go/bin:${PATH} \
    GOTOOLCHAIN=local

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN set -eu; \
    . /opt/rh/gcc-toolset-14/enable; \
    mkdir -p /out; \
    CGO_ENABLED=1 go build -trimpath -buildvcs=false -o /out/inference ./cmd/inference; \
    if readelf -d /out/inference | grep -q 'libonnxruntime'; then \
      echo "engine binary links the runtime library" >&2; \
      exit 1; \
    fi

FROM nvidia/cuda:13.1.2-cudnn-devel-ubi9@sha256:e58c8ebbe874975327026dd2829f0d11ca18df32de0348f3999a2958245e2cb9 AS engine-arm64

ARG TARGETARCH
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        gcc-toolset-14-gcc-c++ \
        gcc-toolset-14-binutils \
        ca-certificates \
        curl \
        tar \
        gzip \
    && case "$TARGETARCH" in \
         amd64) go_sum=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5 ;; \
         arm64) go_sum=3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797 ;; \
         *) echo "no Go archive for ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go1.26.10.linux-${TARGETARCH}.tar.gz" \
    && echo "${go_sum}  /tmp/go.tgz" | sha256sum -c - \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm -f /tmp/go.tgz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

ENV PATH=/usr/local/go/bin:${PATH} \
    GOTOOLCHAIN=local

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN set -eu; \
    . /opt/rh/gcc-toolset-14/enable; \
    mkdir -p /out; \
    CGO_ENABLED=1 go build -trimpath -buildvcs=false -o /out/inference ./cmd/inference; \
    if readelf -d /out/inference | grep -q 'libonnxruntime'; then \
      echo "engine binary links the runtime library" >&2; \
      exit 1; \
    fi

FROM engine-${TARGETARCH} AS engine

FROM nvidia/cuda:13.0.2-cudnn-runtime-ubi9@sha256:30cd1e776cc0d186b95d650b2b29f3ca2e11a2457b87b3be6d229b27f7b96d18 AS cuda-libs-amd64

RUN bash <<'ENDSCRIPT'
set -euo pipefail
mkdir -p /out/lib /out/licenses
copy_glob() {
  dir=$1
  pattern=$2
  found=0
  for f in "$dir"/$pattern; do
    if [ -e "$f" ] || [ -L "$f" ]; then
      cp -a "$f" /out/lib/
      found=1
    fi
  done
  if [ "$found" -ne 1 ]; then
    echo "missing ${pattern} in ${dir}" >&2
    exit 1
  fi
}
copy_glob /usr/local/cuda/lib64 'libcudart.so*'
copy_glob /usr/local/cuda/lib64 'libcublas.so*'
copy_glob /usr/local/cuda/lib64 'libcublasLt.so*'
copy_glob /usr/local/cuda/lib64 'libcufft.so*'
copy_glob /usr/local/cuda/lib64 'libcurand.so*'
copy_glob /usr/lib64 'libcudnn*.so.9*'
for f in /out/lib/*; do
  if [ -L "$f" ]; then
    resolved=$(readlink -f "$f")
    base=$(basename "$resolved")
    if [ ! -e "/out/lib/$base" ]; then
      cp -a "$resolved" "/out/lib/$base"
    fi
    ln -sfn "$base" "$f"
  fi
done
for f in /out/lib/*; do
  if [ -f "$f" ] && [ ! -L "$f" ]; then
    chmod 0755 "$f"
  fi
done
for banned in /out/lib/libcuda.so* /out/lib/libnvidia-ml.so*; do
  if [ -e "$banned" ] || [ -L "$banned" ]; then
    echo "driver library staged: $banned" >&2
    exit 1
  fi
done
license=$(echo /usr/share/licenses/cuda-cudart-*/LICENSE)
if [ ! -f "$license" ]; then
  echo "CUDA license is missing" >&2
  exit 1
fi
cp -a "$license" /out/licenses/cuda-cudart-LICENSE
ENDSCRIPT

FROM nvidia/cuda:13.1.2-cudnn-runtime-ubi9@sha256:ad4982a6342e00980ce725d2cdc309958ec081052bf68e58ac7c30ce7ad270c6 AS cuda-libs-arm64

RUN bash <<'ENDSCRIPT'
set -euo pipefail
